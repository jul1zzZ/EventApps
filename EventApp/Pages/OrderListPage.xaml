<Page x:Class="EventApp.Pages.OrderListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EventApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="1000"
      Title="OrderListPage" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="Orderdata" ItemsSource="{Binding Order}" AutoGenerateColumns="False" HorizontalAlignment="Center" Grid.Row="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Заказчик (Фамилия)" Binding="{Binding UserOrder.User.Surname}"/>
                <DataGridTextColumn Header="Заказчик (Имя)" Binding="{Binding UserOrder.User.Name}"/>
                <DataGridTextColumn Header="Услуга" Binding="{Binding UserOrder.Service.Name}"/>
                <DataGridTemplateColumn Header="Дата заказа">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="DateOrd" Text="{Binding UserOrder.OrderDate,StringFormat=dd.MM.yyyy}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Дата исполнения" Binding="{Binding UserOrder.OrgDate,StringFormat=dd.MM.yyyy}"/>
                <DataGridTextColumn Header="Залог" Binding="{Binding UserOrder.Deposit}"/>
                <DataGridTextColumn Header="Полная стоимость" Binding="{Binding UserOrder.TotalPrice}"/>
                <DataGridTextColumn Header="Организатор" Binding="{Binding Employee.Surname}"/>
                <DataGridTextColumn Header="Место проведения" Binding="{Binding UserOrder.Place.Description}"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Background="#79abe0"  BorderBrush="Transparent" x:Name="AddBtn" VerticalAlignment="Center" HorizontalAlignment="Right" Content="Добавить заказ" Grid.Row="1" Margin="16 0" Click="AddBtn_Click"/>
    </Grid>
</Page>
