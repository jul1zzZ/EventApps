<Page x:Class="EventApp.Pages.ReviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EventApp.Pages"
      mc:Ignorable="d" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ReviewPage" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <ListBox x:Name="ReviewLb" Grid.Row="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Width="750" Style="{StaticResource MaterialDesignCardsListBox}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                        <Grid Margin="10" Background="{Binding GetColor}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="450"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Margin="10 0 0 10">
                            <TextBlock FontSize="18" Margin="0 0 0 10">
                                <Run Text="{Binding Name}"/>
                            </TextBlock>
                            <TextBlock FontSize="16" Margin="0 0 0 10">
                                <Run Text="{Binding Description}"/>
                            </TextBlock>
                            <materialDesign:RatingBar Background="Transparent" x:Name="listingRatingDetail" Margin="0,0,0,0" Foreground="#FFFF6666" Value="{Binding Rating}" BorderBrush="{x:Null}" FontSize="14"/>
                        </StackPanel>
                        </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name="AddBtn" VerticalAlignment="Center" HorizontalAlignment="Right" Width="150" Click="AddBtn_Click" Content="Оставить отзыв" Grid.Row="1" Margin="16 0" Background="#79abe0"  BorderBrush="Transparent"/>
    </Grid>
</Page>
