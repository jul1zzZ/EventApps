<Page x:Class="EventApp.Pages.PersonalOfficePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EventApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PersonalOfficePage" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Width="100" Height="100" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="32 -16 0 0">
            <TextBlock Text="Фамилия: " FontSize="20"/>
            <TextBlock Text="Имя: " FontSize="20"/>
            <TextBlock Text="Отчество: " FontSize="20"/>
        </StackPanel>
        <StackPanel Width="150" Height="100" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="128 -16 0 0">
            <TextBlock x:Name="NameTb" Text="{Binding Surname}" FontSize="20"/>
            <TextBlock x:Name="SurnameTb" Text="{Binding Name}" FontSize="20"/>
            <TextBlock x:Name="PatrTb" Text="{Binding Patronymic}" FontSize="20"/>
        </StackPanel>

        <ListBox x:Name="ClientLb" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Width="750" Style="{StaticResource MaterialDesignCardsListBox}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="450"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Stretch="Uniform" Width="200" Height="200" Source="{Binding Place.GetPhoto}"/>
                            <StackPanel Grid.Column="1" Margin="10 0 0 10">
                                <TextBlock FontSize="18" Margin="0 0 0 10">
                                <Run Text="{Binding Service.Name}"/>
                                </TextBlock>
                            <TextBlock FontSize="16" Margin=" 0 0 0 10">
                                <Run Text="Дата заказа: "/>
                                <Run Text="{Binding OrderDate,StringFormat=dd.MM.yyyy}"/>
                            </TextBlock>
                            <TextBlock FontSize="16" Margin=" 0 0 0 10">
                                <Run Text="Дата организации: "/>
                                <Run Text="{Binding OrgDate,StringFormat=dd.MM.yyyy}"/>
                            </TextBlock>
                            <TextBlock FontSize="14" Margin="0 0 0 10">
                                <Run Text="Депозит при заказе: "/>
                                <Run Text="{Binding Deposit}"/>
                            </TextBlock> 
                                <TextBlock FontSize="14" Margin="0 0 0 10">
                                <Run Text="Итоговая цена: "/>
                                <Run Text="{Binding TotalPrice}"/>
                            </TextBlock>
                            <TextBlock FontSize="14" Margin="0 0 0 10" Background="{Binding GetColor}" Width="150" Foreground="White">
                                <Run Text="Статус заказа: "/>
                                <Run Text="{Binding Status.Name}"/>
                            </TextBlock>
                        </StackPanel>
                        </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</Page>
