<Page x:Class="EventApp.Pages.UserOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EventApp.Pages"
      mc:Ignorable="d" 
       xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UserOrderPage" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Мероприятие" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="0"/>
        <TextBlock Text="Дата заказа" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="1"/>
        <TextBlock Text="Дата организации" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="2"/>
        <TextBlock Text="Место проведения" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="3"/>
        <Button Background="#79abe0"  BorderBrush="Transparent" x:Name="SaveBtn" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="6" Grid.ColumnSpan="2" Click="SaveBtn_Click" Content="Отправить на рассмотрение"/>
        <ComboBox x:Name="EventCb" SelectedItem="{Binding Service}" DisplayMemberPath="GetInfo" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="300"/>
        <DatePicker x:Name="OrderCl" FirstDayOfWeek="Monday" Grid.Row="1" Grid.Column="1" Width="300" Height="225" SelectedDate="{Binding OrderDate}" SelectedDateFormat="Short"/>
        <DatePicker x:Name="OrgCl" FirstDayOfWeek="Monday" Grid.Row="2" Grid.Column="1" Width="300" Height="225" SelectedDate="{Binding OrgDate}" SelectedDateFormat="Short"/>
        <ComboBox  x:Name="PlaceCb" SelectedItem="{Binding Place}" DisplayMemberPath="Description" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="3" Grid.Column="1" Width="300"/>
    </Grid>
</Page>
