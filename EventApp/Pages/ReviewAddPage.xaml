<Page x:Class="EventApp.Pages.ReviewAddPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EventApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="ReviewAddPage" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Ваше имя" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20" Grid.Row="0"/>
        <TextBlock Text="Комментарий" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20" Grid.Row="1"/>
        <TextBlock Text="Рейтинг" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20" Grid.Row="2"/>
        <Button Background="#79abe0"  BorderBrush="Transparent" x:Name="SaveBtn" Click="SaveBtn_Click" Grid.Row="3" Grid.ColumnSpan="2" Content="Оставить отзыв" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <TextBox Text="{Binding Name}" VerticalAlignment="Center" PreviewTextInput="TextBox_PreviewTextInput" HorizontalAlignment="Center" Width="200" Grid.Column="1" Grid.Row="0"/>
        <TextBox Text="{Binding Description}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="200" Grid.Column="1" Grid.Row="1"/>
        <!--<TextBox Text="{Binding Rating}" TextInput="RatingTb_TextInput" PreviewTextInput="RatingTb_PreviewTextInput" MaxLength="1" x:Name="RatingTb" KeyDown="RatingTb_KeyDown" VerticalAlignment="Center"  HorizontalAlignment="Center" Width="200" Grid.Column="1" Grid.Row="2"/>-->
        <ComboBox x:Name="RateCb" Text="{Binding Rating}" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="200">
            <ComboBoxItem Content="1"/>
            <ComboBoxItem Content="2"/>
            <ComboBoxItem Content="3"/>
            <ComboBoxItem Content="4"/>
            <ComboBoxItem Content="5"/>
        </ComboBox>
    </Grid>
</Page>
