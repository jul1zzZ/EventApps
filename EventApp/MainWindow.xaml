<Window x:Class="EventApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EventApp"
        mc:Ignorable="d"
         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Art Event" Height="550" Width="900" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Image Source="\Resources\1621771670_5-phonoteka_org-p-fon-dlya-otkritki-tsveti-akvarel-5.jpg" Grid.RowSpan="3"  Stretch="Fill"/>
        <Border VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="0" Width="1920" Height="80"  Background="White" CornerRadius="10" Opacity="0.5"/>
        <Border VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="2" Width="1920" Height="80" Background="White" CornerRadius="10" Opacity="0.5"/>
        <TextBlock Text="Art Event" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Beyond The Mountains" Margin="4 0 0 0" FontSize="51" FontWeight="Heavy" Foreground="#3381d4" />
        <TextBlock Text="Art Event" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Beyond The Mountains" FontSize="50" FontWeight="Heavy" Foreground="#79abe0" />
        <Button Click="BackBtn_Click" x:Name="BackBtn" Grid.Row="2" Content="Назад" VerticalAlignment="Center" HorizontalAlignment="Right" Width="80" Height="25" Margin="16 0" Background="#79abe0" Foreground="#f7b4b3" FontWeight="Heavy" BorderBrush="Transparent" BorderThickness="0.5" FontFamily="Beyond The Mountains"/>
        <Frame Grid.Row="1" x:Name="MainFrame" ContentRendered="MainFrame_ContentRendered" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
